<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AMAN | Bio Hub</title>
<style>
:root{--c:#00f0ff;--bg:#02070d;--card:#041019;--ok:#19ff4d}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:#e8fdff;font-family:system-ui,-apple-system,Roboto,sans-serif;min-height:100vh;overflow-x:hidden}
#rain{position:fixed;inset:0;z-index:0;opacity:.35}
.wrap{position:relative;z-index:1;max-width:520px;margin:0 auto;padding:36px 18px 60px}
.hidden{display:none!important}

/* verification */
#lock{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px;position:relative;z-index:1}
.box{width:100%;max-width:420px;background:var(--card);border:2px solid #0b6b73;border-radius:36px;padding:34px 24px;text-align:center;box-shadow:0 0 40px rgba(0,240,255,.15)}
.box h2{color:var(--c);font-size:1.5rem;letter-spacing:2px}
.box p{margin:14px 0 22px;color:#9be9f0;font-size:.9rem;padding:8px 0;border-top:1px dashed #0b6b73;border-bottom:1px dashed #0b6b73}
.box input{width:100%;background:#000;border:2px solid var(--c);border-radius:40px;padding:16px;color:var(--c);font-size:1.1rem;text-align:center;letter-spacing:6px;outline:none}
.box input:focus-visible{box-shadow:0 0 0 3px rgba(0,240,255,.4)}
.box button{margin-top:18px;width:100%;padding:16px;border-radius:40px;border:2px solid var(--c);background:linear-gradient(135deg,#02283a,#045070);color:#fff;font-size:1.05rem;font-weight:700;cursor:pointer}
#err{color:#ff5a6e;margin-top:12px;min-height:1.2em;font-size:.9rem}
.shake{animation:sh .35s}
@keyframes sh{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}

/* hero */
.avatar{width:190px;height:190px;margin:0 auto 22px;border-radius:50%;border:4px solid var(--c);display:grid;place-items:center;background:radial-gradient(circle,#06222c,#02070d);box-shadow:0 0 35px var(--c),inset 0 0 25px rgba(0,240,255,.35);font-size:5.5rem;overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover}
h1{text-align:center;color:var(--c);font-size:2.6rem;text-shadow:0 0 18px rgba(0,240,255,.7)}
.handle{text-align:center;color:#2bd6e6;font-size:1.4rem;font-weight:600;margin:4px 0 16px}
.status{width:max-content;max-width:100%;margin:0 auto;border:2px solid var(--ok);border-radius:30px;padding:8px 18px;background:rgba(10,60,20,.35);font-size:.95rem}
.dot{display:inline-block;width:14px;height:14px;border-radius:50%;background:var(--ok);margin-right:8px;vertical-align:-2px;box-shadow:0 0 10px var(--ok)}
.typing{text-align:center;margin:22px 0 40px;color:var(--c);font-size:1.15rem;min-height:1.6em}
.typing i{display:inline-block;width:8px;height:1.1em;background:#999;margin-left:6px;vertical-align:-3px;animation:bl 1s steps(1) infinite}
@keyframes bl{50%{opacity:0}}

/* bio */
.title{text-align:center;font:italic 700 2.4rem Georgia,serif;color:var(--c);padding-bottom:6px;border-bottom:3px solid var(--c);width:max-content;margin:0 auto 26px}
.card{background:rgba(4,16,25,.9);border:1.5px solid #0b6b73;border-radius:36px;padding:10px 22px;box-shadow:0 0 30px rgba(0,240,255,.12)}
.row{padding:16px 0;border-bottom:1px dashed #0b6b73;font-family:Georgia,serif;font-size:1.15rem}
.row:last-child{border-bottom:0}
.row b{color:#fff}
.row span{margin-left:8px}
.row a{color:var(--c)}
.socials{display:flex;justify-content:center;gap:16px;margin-top:28px;flex-wrap:wrap}
.socials a{color:var(--c);border:1.5px solid var(--c);border-radius:30px;padding:10px 18px;text-decoration:none;font-weight:600}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
</head>
<body>
<canvas id="rain"></canvas>

<!-- VERIFICATION SCREEN -->
<section id="lock">
  <div class="box" id="lockbox">
    <h2>VERIFICATION</h2>
    <p>Enter secret code</p>
    <input id="code" type="password" autocomplete="off" autocapitalize="characters" placeholder="•••••">
    <button id="btn">Unlock dashboard</button>
    <div id="err" role="alert"></div>
  </div>
</section>

<!-- MAIN PAGE -->
<main class="wrap hidden" id="main">
  <div class="avatar" id="avatar"></div>
  <h1 id="name"></h1>
  <div class="handle" id="handle"></div>
  <div class="status"><span class="dot"></span><span id="status"></span></div>
  <div class="typing"><span id="typed"></span><i></i></div>

  <div class="title">BIO HUB</div>
  <div class="card" id="card"></div>
  <div class="socials" id="socials"></div>
</main>

<script>
/* ================= APNI INFO YAHAN BADLO ================= */
const CONFIG = {
  secretCode: "AMANYT",             // unlock code
  name: "AMAN",
  username: "Amankaranffyt",        // Telegram username (@ ke bina)
  status: "ONLINE · APNI TAGLINE",
  avatarEmoji: "💀",                // ya photo: avatarImage: "me.jpg"
  avatarImage: "",
  roles: ["Python Developer", "Termux Coder", "Bot Maker - AMAN"],
  bio: [
    ["👤 Name", "Aman"],
    ["⚡ Tg Username", "@Amankaranffyt", "https://t.me/Amankaranffyt"],
    ["🌍 From", "India 🇮🇳"],
    ["📍 State", "Maharashtra, Mumbai"],
    ["🎂 Age", "05/07/2006"],
    ["💎 Status", "Focus on Goals 🎯"],
    ["🔥 Attitude", "apna attitude likho"],
    ["🎯 Dream", "WHITE HAT HACKER"],
    ["🎮 Fav Game", "Free Fire 🔥"],
    ["📱 Fav App", "Chrome"],
    ["⚽ Time Pass", "Coding, Gaming"]
  ],
  socials: [
    ["Telegram", "https://t.me/Amankaranffyt"],
    ["Instagram", "https://instagram.com/Amankaranyt.ff"],
    ["GitHub", "https://github.com/AMANKARANFFYT"]
  ]
};
/* ========================================================= */

const $ = id => document.getElementById(id);

// fill content (textContent keeps it safe from stray HTML)
$("name").textContent = CONFIG.name;
$("handle").textContent = "@" + CONFIG.username;
$("status").textContent = CONFIG.status;
document.title = CONFIG.name + " | Bio Hub";
if (CONFIG.avatarImage) {
  const im = document.createElement("img"); im.src = CONFIG.avatarImage; im.alt = CONFIG.name;
  $("avatar").appendChild(im);
} else $("avatar").textContent = CONFIG.avatarEmoji;

CONFIG.bio.forEach(([label, value, link]) => {
  const r = document.createElement("div"); r.className = "row";
  const b = document.createElement("b"); b.textContent = label + ":";
  const s = document.createElement("span");
  if (link) { const a = document.createElement("a"); a.href = link; a.target = "_blank"; a.rel = "noopener"; a.textContent = value; s.appendChild(a); }
  else s.textContent = value;
  r.append(b, s); $("card").appendChild(r);
});
CONFIG.socials.forEach(([label, url]) => {
  const a = document.createElement("a"); a.href = url; a.target = "_blank"; a.rel = "noopener"; a.textContent = label;
  $("socials").appendChild(a);
});

// unlock
function unlock() {
  if ($("code").value.trim().toUpperCase() === CONFIG.secretCode.toUpperCase()) {
    $("lock").classList.add("hidden");
    $("main").classList.remove("hidden");
    typeLoop();
  } else {
    $("err").textContent = "Wrong code. Try again.";
    $("lockbox").classList.remove("shake"); void $("lockbox").offsetWidth; $("lockbox").classList.add("shake");
    $("code").value = "";
  }
}
$("btn").onclick = unlock;
$("code").addEventListener("keydown", e => { if (e.key === "Enter") unlock(); });

// typing effect
let ri = 0, ci = 0, del = false;
function typeLoop() {
  const word = CONFIG.roles[ri];
  $("typed").textContent = "⚡ " + word.slice(0, ci);
  if (!del && ci < word.length) ci++;
  else if (!del) { del = true; return setTimeout(typeLoop, 1200); }
  else if (ci > 0) ci--;
  else { del = false; ri = (ri + 1) % CONFIG.roles.length; }
  setTimeout(typeLoop, del ? 40 : 90);
}

// matrix rain
const cv = $("rain"), cx = cv.getContext("2d");
const chars = "01アイウエオカキクケコサシスセソ23456789";
let cols, drops;
function size() { cv.width = innerWidth; cv.height = innerHeight; cols = Math.floor(cv.width / 18); drops = Array(cols).fill(1); }
size(); addEventListener("resize", size);
setInterval(() => {
  cx.fillStyle = "rgba(2,7,13,.1)"; cx.fillRect(0, 0, cv.width, cv.height);
  cx.fillStyle = "#00f0ff"; cx.font = "16px monospace";
  drops.forEach((y, i) => {
    cx.fillText(chars[Math.floor(Math.random() * chars.length)], i * 18, y * 18);
    if (y * 18 > cv.height && Math.random() > .975) drops[i] = 0;
    drops[i]++;
  });
}, 60);
</script>
</body>
</html>
